# Copy to .env and fill in. Never commit the real .env.
# NOVA reads OPENAI_API_KEY first (works with OpenAI, OpenRouter, etc.)
OPENAI_API_KEY=your_api_key_here

# Optional overrides (production: edit this file, never the UI):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Production branding (window title, home screen, tray):
# APP_NAME=My Partner

# Optional Gmail watcher (buddy bubble shows new mail subjects).
# Google Account -> Security -> 2-Step Verification -> App passwords.
# Stays in THIS file only. Leave unset to disable.
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
